# ─── Database ────────────────────────────────────────────
# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/comptech_pro
# Render:  Comes from the linked Render Postgres database (DATABASE_URL auto-injected)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comptech_pro"

# ─── JWT ─────────────────────────────────────────────────
# 🔐 Generate with: openssl rand -base64 64
# NEVER commit the real value! Set in Render Dashboard instead.
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="7d"

# ─── Auth (dev only) ────────────────────────────────────
# Set to "true" to skip password verification (dev/test only)
# ⚠️ NEVER enable in production
AUTH_BYPASS="false"

# ─── Demo Reset ──────────────────────────────────────────
# 🔐 Protect POST /api/demo/reset endpoint.
# Generate with: openssl rand -hex 32
# cron-job.org sends this as x-reset-secret header.
# REQUIRED for production — leave empty to disable protection.
RESET_SECRET="change_me_in_production"

# ─── Server ──────────────────────────────────────────────
PORT=3001

# ─── CORS ────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins that may call the API.
# Include EVERY origin that can reach the backend directly:
#   Local dev:              http://localhost:3000
#   New subdomain:          https://demo.mallottidigital.com
#   Old Vercel URL:         https://comptech-frontend-xyz.vercel.app  (transition)
#   Landing page:           https://mallottidigital.com
# Falls back to http://localhost:3000 (local dev) when unset.
# NEVER use "*" with credentials.
CORS_ORIGINS="http://localhost:3000,https://demo.mallottidigital.com,https://mallottidigital.com"
