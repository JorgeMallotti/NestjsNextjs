# ─── Database ────────────────────────────────────────────
# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/comptech_pro
# Railway:  Comes from Railway PostgreSQL plugin (variable auto-injected)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comptech_pro"

# ─── JWT ─────────────────────────────────────────────────
# 🔐 Generate with: openssl rand -base64 64
# NEVER commit the real value! Set in Railway Dashboard instead.
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="7d"

# ─── Auth (dev only) ────────────────────────────────────
# Set to "true" to skip password verification (dev/test only)
# ⚠️ NEVER enable in production
AUTH_BYPASS="false"

# ─── Demo Reset ──────────────────────────────────────────
# 🔐 Protect POST /api/demo/reset endpoint.
# Generate with: openssl rand -hex 32
# cron-job.org sends this as x-reset-secret header.
# REQUIRED for production — leave empty to disable protection.
RESET_SECRET="change_me_in_production"

# ─── Server ──────────────────────────────────────────────
PORT=3001

# ─── CORS ────────────────────────────────────────────────
# Frontend origin for CORS.
# Local:  http://localhost:3000
# Vercel: https://teu-projeto.vercel.app
FRONTEND_URL="http://localhost:3000"
