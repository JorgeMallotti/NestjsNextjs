# ─── Next.js Proxy Target ────────────────────────────────
# The NestJS backend URL that Next.js forwards /api/* requests to.
# Defaults to http://localhost:3001 in development.
# In production set this to your deployed backend, e.g.:
#   https://comptech-backend.up.railway.app
#   https://comptech-backend.koyeb.app
API_PROXY_TARGET="http://localhost:3001"

# ─── Direct API override (optional) ─────────────────────
# Leave UNSET to use the /api rewrite (recommended — keeps the auth
# cookie same-origin and removes CORS in production).
# Only set this if you want the frontend to call the backend directly:
# NEXT_PUBLIC_API_URL="http://localhost:3001/api"
